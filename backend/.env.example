# ============================================
# QuantBase backend environment template
# Copy this file to .env and keep real secrets out of git.
# ============================================

# Optional proxy configuration
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# Exchange API configuration.
# Public-data paths do not require private keys. Keep private keys local.
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# Optional AI research provider configuration.
DASHSCOPE_API_KEY=
# QWEN_API_KEY=
# AI_AGENT_MODEL=qwen3.6-plus
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_AGENT_ENABLE_THINKING=false
# AI_AGENT_THINKING_BUDGET=512
# AI_AGENT_REQUEST_TIMEOUT=180
AGENT_MAX_ITERATIONS=10
AGENT_CODE_TIMEOUT=120
HERMES_AGENT_ENABLED=false
HERMES_AGENT_COMMAND=hermes
HERMES_AGENT_TIMEOUT=240

# Optional API session access control for forks or deployment-layer integrations.
# The community frontend does not ship a login page. Keep this false unless
# you provide your own auth flow or API-only access path.
QUANTBASE_AUTH_ENABLED=false
QUANTBASE_ADMIN_USERNAME=
QUANTBASE_ADMIN_PASSWORD_HASH=
QUANTBASE_AUTH_COOKIE_NAME=quantbase_session
QUANTBASE_AUTH_COOKIE_SECURE=false
QUANTBASE_ADMIN_SESSION_HOURS=87600

# Real-account read and live-execution switches. Keep disabled for public demos.
QUANTBASE_LIVE_TRADING_ENABLED=false
QUANTBASE_MCP_ENABLE_LIVE_TRADING=0
# QUANTBASE_MCP_API_BASE=http://127.0.0.1:8889
# QUANTBASE_MCP_AUDIT_PATH=logs/mcp_live_audit.jsonl

# Optional Redis configuration
# REDIS_URL=redis://localhost:6379/0

# Application configuration
BACKEND_CORS_ORIGINS=["http://localhost:8888","http://127.0.0.1:8888"]
LOG_LEVEL=INFO

# Database configuration
DB_PATH=

# Data sync intervals
SYNC_INTERVAL_TICKER=10
SYNC_INTERVAL_FUNDING=60
SYNC_INTERVAL_KLINE=300

# Optional notification webhook. Leave disabled for community demos.
FEISHU_WEBHOOK_URL=
ENABLE_FEISHU_NOTIFY=False
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
FEISHU_PROFIT_CARD_IMAGE_ENABLED=False
